# AI providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
REPLICATE_API_KEY=
ELEVENLABS_API_KEY=
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=visual_learner

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
